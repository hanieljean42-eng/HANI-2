{
  "expo": {
    "name": "HANI 2",
    "slug": "loveapp2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B9D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loveapp.couple2026",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Nous utilisons les notifications pour vous alerter des messages de votre partenaire.",
        "NSMicrophoneUsageDescription": "L'accès au microphone est nécessaire pour les appels vocaux et les messages vocaux.",
        "NSCameraUsageDescription": "L'accès à la caméra est nécessaire pour les appels vidéo et envoyer des preuves photo/vidéo.",
        "NSPhotoLibraryUsageDescription": "L'accès à vos photos est nécessaire pour envoyer des images et des vidéos à votre partenaire.",
        "NSPhotoLibraryAddUsageDescription": "L'accès à votre photothèque est nécessaire pour sauvegarder vos souvenirs.",
        "UIBackgroundModes": ["audio", "voip"]
      },
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B9D"
      },
      "package": "com.loveapp.couple2026",
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "newArchEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "hani2",
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application a besoin d'accéder à vos photos et vidéos pour les envoyer à votre partenaire.",
          "cameraPermission": "L'application a besoin d'accéder à votre caméra pour prendre des photos et vidéos.",
          "microphonePermission": "L'application a besoin du microphone pour enregistrer des vidéos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF6B9D",
          "sounds": [],
          "mode": "production"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#FF6B9D",
      "androidMode": "default",
      "androidCollapsedTitle": "HANI 2 💕"
    },
    "extra": {
      "eas": {
        "projectId": "81e2658b-bb55-4a97-ac63-d1c63bca11fc"
      }
    },
    "owner": "sialou2"
  }
}
